+SECURITY_READ_ONLY_LATE(int) sweet_gic_v2 = 0;
+static vm_offset_t gicc_base;
+static uint8_t gicv2_cpu_mask[MAX_CPUS];
+#define GICD_ISENABLER0_V2      0x100
+#define GICD_IGROUPR0_V2        0x080
+#define GICD_IPRIORITYR0_V2     0x400
+#define GICD_ITARGETSR0_V2      0x800
+#define GICD_SGIR_V2            0xF00
+#define GICC_CTLR_V2            0x00
+#define GICC_PMR_V2             0x04
+#define GICC_BPR_V2             0x08
+#define GICC_IAR_V2             0x0C
