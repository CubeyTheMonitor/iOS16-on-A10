+#if defined(SWEET)
+/*
+ * A40 (Exynos 7904): GIC-400 = GICv2, memory-mapped CPU interface, no
+ * system registers. Selected at runtime from /arm-io/gic compatible
+ * "arm,gic-400" (QEMU virt gic-version=2 uses the same tree), so one
+ * kernel boots both the phone and the emulator.
