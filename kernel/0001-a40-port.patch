+	_gic_write32(gicc_base + GICC_CTLR_V2, _gic_read32(gicc_base + GICC_CTLR_V2) | 0x7);   /* NS view: bit0 = Grp1; no security ext: Grp0|Grp1|AckCtl */
+	gicd_write32(GICD_CTLR, gicd_read32(GICD_CTLR) | 0x3);
+	__builtin_arm_isb(ISB_SY);
+	kprintf("A40 GIC: GICv2 cpu %u interface mask 0x%x ctlr 0x%x\n", cpu, m,
