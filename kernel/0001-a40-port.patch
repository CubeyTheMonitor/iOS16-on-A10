+{
+	/* ITARGETSR0..7 are banked and read back this CPU interface's own bit. */
+	uint32_t m = gicd_read32(GICD_ITARGETSR0_V2) & 0xFF;
+	if (!m) {
+		m = (gicd_read32(GICD_ITARGETSR0_V2 + 0x1C) >> 24) & 0xFF;
+	}
+	if (!m) {
+		m = 1;          /* uniprocessor GIC: ITARGETSR is RAZ, one interface */
+	}
