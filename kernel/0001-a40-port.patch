 {
@@ -50,6 +72,72 @@ _gic_write32(vm_offset_t addr, uint32_t value)
 #define gicr_write32(offset, data) (_gic_write32(gicr_pe_base + (offset), (data)))
 #define gicr_read64(offset) (_gic_read64(gicr_pe_base + (offset)))
 
+#if defined(SWEET)
+uint32_t
+pe_gic_ack(void)
+{
+	if (sweet_gic_v2) {
+		return _gic_read32(gicc_base + GICC_IAR_V2);
+	}
+	return (uint32_t)__builtin_arm_rsr64("ICC_IAR1_EL1");
+}
+
+void
+pe_gic_eoi(uint32_t iar)
+{
+	if (sweet_gic_v2) {
+		_gic_write32(gicc_base + GICC_EOIR_V2, iar);
+		return;
+	}
+	__builtin_arm_wsr64("ICC_EOIR1_EL1", (uint64_t)iar);
+}
