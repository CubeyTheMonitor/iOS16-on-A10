--- /dev/null
+++ b/bsd/dev/a40_blk.c
@@ -0,0 +1,616 @@
+/*
+ * A40 block backends for bsd/dev/sweet_ufs.c (same 4 KiB "device block"
+ * interface and the same 1 MiB bounce buffer as the UFS path):
+ *
+ *   - "a40,dwmmc": Exynos 7904 eMMC (Synopsys DesignWare MSHC, dwmmc0 at
+ *     0x13500000). S-Boot leaves the controller clocked and the card in the
+ *     transfer state after loading boot.img, so nothing is (re)initialised:
+ *     the driver only disables the internal DMA, resets the FIFO and moves
+ *     data by PIO with multi-block CMD18 / CMD25 (+ auto stop). Card is
+ *     sector addressed (eMMC > 2 GB), 512-byte sectors.
+ *   - "virtio,mmio": QEMU virt virtio-blk (legacy virtio-mmio v1, one
+ *     polled queue), used to run the whole iOS boot in the emulator.
+ *
+ * Everything is polled; no interrupts are used.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <machine/machine_routines.h>
+#include <libkern/OSAtomic.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+#define BLK4K           4096u
+#define SECT            512u
+#define SECT_PER_BLK    (BLK4K / SECT)
+
+int a40_blk_kind;                       /* 0 none, 1 dwmmc, 2 virtio */
+static vm_offset_t a40_regs;
+static vm_offset_t a40_bounce;          /* VA of the shared 1 MiB bounce buffer */
+static uint64_t a40_bounce_pa;
+static uint32_t a40_bounce_size;
+
+static inline uint32_t
+r32(uint32_t off)
+{
+	return *(volatile uint32_t *)(a40_regs + off);
+}
+
+static inline void
+w32(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(a40_regs + off) = v;
+}
+
+static bool
+timed_out(uint64_t deadline)
+{
+	return mach_absolute_time() > deadline;
+}
+
+static uint64_t
+deadline_ms(uint32_t ms)
+{
+	uint64_t t;
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &t);
+	return mach_absolute_time() + t;
+}
+
+/* ------------------------------------------------------------------ */
+/* DesignWare MSHC (dw_mmc), register offsets from Linux dw_mmc.h      */
+
+#define DW_CTRL         0x000
+#define DW_CLKENA       0x010
+#define DW_TMOUT        0x014
+#define DW_CTYPE        0x018
+#define DW_BLKSIZ       0x01c
+#define DW_BYTCNT       0x020
+#define DW_INTMASK      0x024
+#define DW_CMDARG       0x028
+#define DW_CMD          0x02c
+#define DW_RESP0        0x030
+#define DW_MINTSTS      0x040
+#define DW_RINTSTS      0x044
+#define DW_STATUS       0x048
+#define DW_FIFOTH       0x04c
+#define DW_VERID        0x06c
+#define DW_BMOD         0x080
+#define DW_IDINTEN      0x090
+
+#define CTRL_RESET              (1u << 0)
+#define CTRL_FIFO_RESET         (1u << 1)
+#define CTRL_DMA_RESET          (1u << 2)
+#define CTRL_INT_ENABLE         (1u << 4)
+#define CTRL_DMA_ENABLE         (1u << 5)
+#define CTRL_USE_IDMAC          (1u << 25)
+
+#define CMD_START               (1u << 31)
+#define CMD_USE_HOLD_REG        (1u << 29)
+#define CMD_PRV_DAT_WAIT        (1u << 13)
+#define CMD_SEND_STOP           (1u << 12)
+#define CMD_DAT_WR              (1u << 10)
+#define CMD_DAT_EXP             (1u << 9)
+#define CMD_RESP_CRC            (1u << 8)
+#define CMD_RESP_EXP            (1u << 6)
+
+#define INT_EBE                 (1u << 15)      /* end-bit error (read) / write no CRC */
+#define INT_ACD                 (1u << 14)      /* auto command done */
+#define INT_SBE                 (1u << 13)      /* start-bit / busy clear */
+#define INT_HLE                 (1u << 12)
+#define INT_FRUN                (1u << 11)
+#define INT_HTO                 (1u << 10)
+#define INT_DRTO                (1u << 9)
+#define INT_RTO                 (1u << 8)
+#define INT_DCRC                (1u << 7)
+#define INT_RCRC                (1u << 6)
+#define INT_RXDR                (1u << 5)
+#define INT_TXDR                (1u << 4)
+#define INT_DTO                 (1u << 3)
+#define INT_CMD_DONE            (1u << 2)
+#define INT_RESP_ERR            (1u << 1)
+#define INT_DATA_ERR            (INT_EBE | INT_SBE | INT_HLE | INT_FRUN | INT_DCRC | INT_DRTO)
+#define INT_CMD_ERR             (INT_RTO | INT_RCRC | INT_RESP_ERR | INT_HLE)
+
+#define STATUS_FIFO_COUNT(s)    (((s) >> 17) & 0x1fff)
+#define STATUS_BUSY             (1u << 9)
+
+static uint32_t dw_data;                /* FIFO offset: 0x100 before 2.40a, else 0x200 */
+static uint32_t dw_fifo_words;          /* FIFO depth in entries (32 or 64 bit) */
+static bool dw_hold;                    /* CMD_USE_HOLD_REG like the bootloader */
+static bool dw_fifo64;                  /* HCON H_DATA_WIDTH = 64 bit (Exynos) */
+static uint32_t dw_rca = 1;
+uint32_t a40_mmc_diag[8];               /* shown by the persistent log / panics */
+
+static int
+dw_wait_cmd_taken(void)
+{
+	uint64_t dl = deadline_ms(500);
+	while (r32(DW_CMD) & CMD_START) {
+		if (timed_out(dl)) {
+			return ETIMEDOUT;
+		}
+	}
+	return 0;
+}
+
+static int
+dw_wait_not_busy(uint32_t ms)
+{
+	uint64_t dl = deadline_ms(ms);
+	while (r32(DW_STATUS) & STATUS_BUSY) {
+		if (timed_out(dl)) {
+			return ETIMEDOUT;
+		}
+	}
+	return 0;
+}
+
+/* Issue a command; for data commands the caller moves the FIFO afterwards. */
+static int
+dw_cmd(uint32_t idx, uint32_t arg, uint32_t flags, uint32_t *resp)
+{
+	int e = dw_wait_not_busy(1000);
+	if (e && !(flags & CMD_DAT_EXP)) {
+		/* busy only matters for commands that wait for previous data */
+	}
+	w32(DW_RINTSTS, 0xffffffff);
+	w32(DW_CMDARG, arg);
+	__builtin_arm_dsb(0xf);
+	w32(DW_CMD, CMD_START | (dw_hold ? CMD_USE_HOLD_REG : 0) | flags | (idx & 0x3f));
+	if ((e = dw_wait_cmd_taken())) {
+		a40_mmc_diag[0] = 0xC0DE0000 | idx;
+		return e;
+	}
+	uint64_t dl = deadline_ms(1000);
+	uint32_t st;
+	while (!((st = r32(DW_RINTSTS)) & (INT_CMD_DONE | INT_CMD_ERR))) {
+		if (timed_out(dl)) {
+			a40_mmc_diag[1] = 0xC0DE1000 | idx;
+			return ETIMEDOUT;
+		}
+	}
+	if (st & INT_CMD_ERR) {
+		a40_mmc_diag[2] = st;
+		a40_mmc_diag[3] = idx;
+		return EIO;
+	}
+	if (resp) {
+		*resp = r32(DW_RESP0);
+	}
+	return 0;
+}
+
+#define R1      (CMD_RESP_EXP | CMD_RESP_CRC)
+
+static int
+dw_card_ready(void)
+{
+	/* CMD13 SEND_STATUS until READY_FOR_DATA in TRAN state */
+	uint64_t dl = deadline_ms(2000);
+	for (;;) {
+		uint32_t st = 0;
+		int e = dw_cmd(13, dw_rca << 16, R1 | CMD_PRV_DAT_WAIT, &st);
+		if (!e && (st & (1u << 8)) && ((st >> 9) & 0xf) == 4) {
+			return 0;
+		}
+		if (timed_out(dl)) {
+			a40_mmc_diag[4] = st;
+			return e ? e : ETIMEDOUT;
+		}
+	}
+}
+
+static void
+dw_fifo_reset(void)
+{
+	w32(DW_CTRL, r32(DW_CTRL) | CTRL_FIFO_RESET);
+	uint64_t dl = deadline_ms(100);
+	while ((r32(DW_CTRL) & CTRL_FIFO_RESET) && !timed_out(dl)) {
+	}
+}
+
+/* sectors of 512 bytes at sector address 'sect', to/from the bounce buffer */
+/* FIFO_COUNT and the data port use the FIFO width (32 or 64 bit). */
+static void
+dw_fifo_read(volatile uint32_t *buf, uint32_t *done, uint32_t words)
+{
+	uint32_t n = STATUS_FIFO_COUNT(r32(DW_STATUS));
+	if (dw_fifo64) {
+		volatile uint64_t *b64 = (volatile uint64_t *)buf;
+		while (n-- && *done < words) {
+			b64[*done / 2] = *(volatile uint64_t *)(a40_regs + dw_data);
+			*done += 2;
+		}
+		return;
+	}
+	while (n-- && *done < words) {
+		buf[(*done)++] = *(volatile uint32_t *)(a40_regs + dw_data);
+	}
+}
+
+static void
+dw_fifo_write(volatile uint32_t *buf, uint32_t *done, uint32_t words)
+{
+	uint32_t fill = STATUS_FIFO_COUNT(r32(DW_STATUS));
+	uint32_t room = fill < dw_fifo_words ? dw_fifo_words - fill : 0;
+	if (dw_fifo64) {
+		volatile uint64_t *b64 = (volatile uint64_t *)buf;
+		while (room-- && *done < words) {
+			*(volatile uint64_t *)(a40_regs + dw_data) = b64[*done / 2];
+			*done += 2;
+		}
+		return;
+	}
+	while (room-- && *done < words) {
+		*(volatile uint32_t *)(a40_regs + dw_data) = buf[(*done)++];
+	}
+}
+
+static int
+dw_xfer(uint64_t sect, uint32_t nsect, bool write)
+{
+	if (sect > UINT32_MAX || nsect == 0) {
+		return EINVAL;
+	}
+	int e = dw_card_ready();
+	if (e) {
+		return e;
+	}
+	dw_fifo_reset();
+	uint32_t bytes = nsect * SECT;
+	w32(DW_BLKSIZ, SECT);
+	w32(DW_BYTCNT, bytes);
+	uint32_t idx = write ? (nsect > 1 ? 25 : 24) : (nsect > 1 ? 18 : 17);
+	uint32_t flags = R1 | CMD_DAT_EXP | CMD_PRV_DAT_WAIT |
+	    (write ? CMD_DAT_WR : 0) | (nsect > 1 ? CMD_SEND_STOP : 0);
+	if ((e = dw_cmd(idx, (uint32_t)sect, flags, NULL))) {
+		goto fail;
+	}
+	volatile uint32_t *buf = (volatile uint32_t *)a40_bounce;
+	uint32_t words = bytes / 4, done = 0;
+	uint64_t dl = deadline_ms(5000);
+	for (;;) {
+		uint32_t is = r32(DW_RINTSTS);
+		if (is & INT_DATA_ERR) {
+			a40_mmc_diag[5] = is;
+			e = EIO;
+			goto fail;
+		}
+		if (!write) {
+			dw_fifo_read(buf, &done, words);
+			if (is & INT_RXDR) {
+				w32(DW_RINTSTS, INT_RXDR);
+			}
+		} else if (done < words) {
+			dw_fifo_write(buf, &done, words);
+			if (is & INT_TXDR) {
+				w32(DW_RINTSTS, INT_TXDR);
+			}
+		}
+		if ((is & INT_DTO) && (write || done >= words)) {
+			break;
+		}
+		if (timed_out(dl)) {
+			a40_mmc_diag[6] = is;
+			a40_mmc_diag[7] = done;
+			e = ETIMEDOUT;
+			goto fail;
+		}
+	}
+	if (!write) {
+		/* drain anything left after DTO */
+		dw_fifo_read(buf, &done, words);
+		if (done < words) {
+			a40_mmc_diag[7] = 0xD0000000 | done;
+			e = EIO;
+			goto fail;
+		}
+	}
+	if (nsect > 1) {
+		/* auto stop (CMD12) completes with ACD */
+		uint64_t d2 = deadline_ms(1000);
+		while (!(r32(DW_RINTSTS) & INT_ACD) && !timed_out(d2)) {
+		}
+	}
+	w32(DW_RINTSTS, 0xffffffff);
+	return dw_wait_not_busy(2000);
+fail:
+	/* stop any open-ended transfer and get the card back to TRAN */
+	(void)dw_cmd(12, 0, R1 | (1u << 14) /* stop_abort_cmd */, NULL);
+	dw_fifo_reset();
+	w32(DW_RINTSTS, 0xffffffff);
+	return e;
+}
+
+static uint32_t dw_boot[12];            /* controller state left by S-Boot */
+
+static void __dead2
+a40_mmc_fail(const char *stage, int e)
+{
+	panic("A40 MMC %s err %d rca %u | boot ctrl %x clkena %x clkdiv %x ctype %x status %x "
+	    "rint %x cmd %x arg %x resp0 %x uhs %x clksel %x verid %x | now status %x rint %x cmd %x | "
+	    "hcon %x | diag %x %x %x %x %x %x %x %x", stage, e, dw_rca,
+	    dw_boot[0], dw_boot[1], dw_boot[2], dw_boot[3], dw_boot[4], dw_boot[5], dw_boot[6],
+	    dw_boot[7], dw_boot[8], dw_boot[9], dw_boot[10], dw_boot[11],
+	    r32(DW_STATUS), r32(DW_RINTSTS), r32(DW_CMD), r32(0x070),
+	    a40_mmc_diag[0], a40_mmc_diag[1], a40_mmc_diag[2], a40_mmc_diag[3],
+	    a40_mmc_diag[4], a40_mmc_diag[5], a40_mmc_diag[6], a40_mmc_diag[7]);
+}
+
+static int
+dw_probe(void)
+{
+	static const uint16_t snap[12] = { 0x000, 0x010, 0x008, 0x018, 0x048, 0x044, 0x02c, 0x028,
+		                           0x030, 0x074, 0x09c, 0x06c };
+	for (int i = 0; i < 12; i++) {
+		dw_boot[i] = r32(snap[i]);
+	}
+	uint32_t ver = r32(DW_VERID) & 0xffff;
+	dw_data = ver < 0x240a ? 0x100 : 0x200;
+	uint32_t fifoth = r32(DW_FIFOTH);
+	dw_fifo_words = ((fifoth >> 16) & 0xfff) + 1;           /* RX_WMark + 1 = depth/2 */
+	dw_fifo_words = dw_fifo_words * 2;                      /* FIFO entries (32 or 64 bit) */
+	if (dw_fifo_words < 16 || dw_fifo_words > 4096) {
+		dw_fifo_words = 64;                             /* dts fifo-depth = <0x40> */
+	}
+	dw_hold = true;
+	dw_fifo64 = ((r32(0x070) >> 7) & 7) == 2;              /* HCON: 0 16-bit, 1 32-bit, 2 64-bit */
+	printf("A40 MMC: dw_mmc verid 0x%x ctrl 0x%x clkena 0x%x ctype 0x%x status 0x%x fifo %u words\n",
+	    ver, r32(DW_CTRL), r32(DW_CLKENA), r32(DW_CTYPE), r32(DW_STATUS), dw_fifo_words);
+	if (!r32(DW_CLKENA)) {
+		a40_mmc_fail("clock off", ENXIO);
+	}
+	/* polled PIO: no interrupts, no internal DMA */
+	w32(DW_INTMASK, 0);
+	w32(DW_IDINTEN, 0);
+	w32(DW_CTRL, (r32(DW_CTRL) & ~(CTRL_INT_ENABLE | CTRL_DMA_ENABLE | CTRL_USE_IDMAC)));
+	w32(DW_BMOD, r32(DW_BMOD) & ~(1u << 7));                /* IDMAC off */
+	w32(DW_CTRL, r32(DW_CTRL) | CTRL_DMA_RESET | CTRL_FIFO_RESET);
+	uint64_t dl = deadline_ms(100);
+	while ((r32(DW_CTRL) & (CTRL_DMA_RESET | CTRL_FIFO_RESET)) && !timed_out(dl)) {
+	}
+	w32(DW_TMOUT, 0xffffffff);
+	w32(DW_RINTSTS, 0xffffffff);
+	/* eMMC RCA: S-Boot (like Linux) assigns 1; check, else try 2 */
+	if (dw_card_ready() != 0) {
+		dw_rca = 2;
+		if (dw_card_ready() != 0) {
+			a40_mmc_fail("CMD13 not tran", EIO);
+		}
+	}
+	printf("A40 MMC: card RCA %u ready\n", dw_rca);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* virtio-mmio legacy (v1) block device, QEMU virt                      */
+
+#define VIO_MAGIC       0x000
+#define VIO_VERSION     0x004
+#define VIO_DEVICE_ID   0x008
+#define VIO_HOST_FEAT   0x010
+#define VIO_GUEST_FEAT  0x020
+#define VIO_GUEST_PGSZ  0x028
+#define VIO_QSEL        0x030
+#define VIO_QNUM_MAX    0x034
+#define VIO_QNUM        0x038
+#define VIO_QALIGN      0x03c
+#define VIO_QPFN        0x040
+#define VIO_QNOTIFY     0x050
+#define VIO_ISR         0x060
+#define VIO_ISR_ACK     0x064
+#define VIO_STATUS      0x070
+#define VIO_CONFIG      0x100
+
+#define VQ_N            8
+struct vq_desc {
+	uint64_t addr;
+	uint32_t len;
+	uint16_t flags, next;
+};
+struct vblk_req {
+	uint32_t type, reserved;
+	uint64_t sector;
+};
+
+/* queue memory: 4 KiB aligned, legacy layout (desc, avail, pad, used) */
+static vm_offset_t vq_mem;
+static uint64_t vq_pa;
+static uint16_t vq_avail_idx, vq_used_seen;
+#define VQ_DESC         0x000
+#define VQ_AVAIL        (VQ_N * 16)
+#define VQ_USED         0x1000
+#define VQ_REQ          0x2000
+#define VQ_STATUSB      0x2040
+#define VQ_MEM          0x3000
+
+static void
+vq_sync(void)
+{
+	flush_dcache64((addr64_t)vq_pa, VQ_MEM, TRUE);
+}
+
+static int
+vio_xfer(uint64_t sect, uint32_t nsect, bool write)
+{
+	volatile struct vq_desc *d = (volatile struct vq_desc *)(vq_mem + VQ_DESC);
+	volatile struct vblk_req *rq = (volatile struct vblk_req *)(vq_mem + VQ_REQ);
+	volatile uint8_t *status = (volatile uint8_t *)(vq_mem + VQ_STATUSB);
+	volatile uint16_t *avail = (volatile uint16_t *)(vq_mem + VQ_AVAIL);
+	volatile uint16_t *used = (volatile uint16_t *)(vq_mem + VQ_USED);
+
+	rq->type = write ? 1 : 0;
+	rq->reserved = 0;
+	rq->sector = sect;
+	*status = 0xff;
+	d[0].addr = vq_pa + VQ_REQ;
+	d[0].len = sizeof(struct vblk_req);
+	d[0].flags = 1;                 /* NEXT */
+	d[0].next = 1;
+	d[1].addr = a40_bounce_pa;
+	d[1].len = nsect * SECT;
+	d[1].flags = 1 | (write ? 0 : 2);       /* NEXT | WRITE(device writes) */
+	d[1].next = 2;
+	d[2].addr = vq_pa + VQ_STATUSB;
+	d[2].len = 1;
+	d[2].flags = 2;
+	d[2].next = 0;
+	avail[2 + (vq_avail_idx % VQ_N)] = 0;
+	__builtin_arm_dmb(0xf);
+	avail[1] = ++vq_avail_idx;
+	flush_dcache64((addr64_t)a40_bounce_pa, nsect * SECT, TRUE);
+	vq_sync();
+	__builtin_arm_dsb(0xf);
+	w32(VIO_QNOTIFY, 0);
+	uint64_t dl = deadline_ms(10000);
+	for (;;) {
+		vq_sync();
+		if (used[1] != vq_used_seen) {
+			break;
+		}
+		if (timed_out(dl)) {
+			return ETIMEDOUT;
+		}
+	}
+	vq_used_seen = used[1];
+	w32(VIO_ISR_ACK, r32(VIO_ISR));
+	flush_dcache64((addr64_t)a40_bounce_pa, nsect * SECT, TRUE);
+	return *status == 0 ? 0 : EIO;
+}
+
+
+static int
+vio_probe(uint64_t base_pa, uint32_t slots, uint32_t stride)
+{
+	for (uint32_t i = 0; i < slots; i++) {
+		vm_offset_t r = ml_io_map(base_pa + (uint64_t)i * stride, stride);
+		uint32_t magic = *(volatile uint32_t *)(r + VIO_MAGIC);
+		uint32_t devid = *(volatile uint32_t *)(r + VIO_DEVICE_ID);
+		if (magic == 0x74726976 && devid == 2) {
+			a40_regs = r;
+			break;
+		}
+	}
+	if (!a40_regs) {
+		printf("A40 VIRTIO: no virtio-blk device\n");
+		return ENXIO;
+	}
+	if (r32(VIO_VERSION) != 1) {
+		printf("A40 VIRTIO: version %u (need legacy 1: -global virtio-mmio.force-legacy=true)\n", r32(VIO_VERSION));
+		return ENXIO;
+	}
+	w32(VIO_STATUS, 0);
+	w32(VIO_STATUS, 1 | 2);         /* ACK | DRIVER */
+	w32(VIO_GUEST_FEAT, 0);
+	w32(VIO_GUEST_PGSZ, 4096);
+	w32(VIO_QSEL, 0);
+	if (r32(VIO_QNUM_MAX) < VQ_N) {
+		return ENXIO;
+	}
+	if (kmem_alloc_contig(kernel_map, &vq_mem, VQ_MEM, 0x3fff, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	vq_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)vq_mem));
+	vq_sync();
+	w32(VIO_QNUM, VQ_N);
+	w32(VIO_QALIGN, 4096);
+	w32(VIO_QPFN, (uint32_t)(vq_pa >> 12));
+	w32(VIO_STATUS, 1 | 2 | 4);     /* DRIVER_OK */
+	uint64_t cap = *(volatile uint32_t *)(a40_regs + VIO_CONFIG) |
+	    ((uint64_t)*(volatile uint32_t *)(a40_regs + VIO_CONFIG + 4) << 32);
+	printf("A40 VIRTIO: virtio-blk %llu MiB, queue at 0x%llx\n", cap * SECT >> 20, vq_pa);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Interface used by sweet_ufs.c                                       */
+
+int a40_blk_probe(vm_offset_t bounce, uint64_t bounce_pa, uint32_t bounce_size);
+int a40_blk_read(uint64_t blk4k, uint32_t count);
+int a40_blk_write(uint64_t blk4k, uint32_t count);
+
+int
+a40_blk_probe(vm_offset_t bounce, uint64_t bounce_pa, uint32_t bounce_size)
+{
+	DTEntry node;
+	uint64_t const *reg = NULL;
+	unsigned int size = 0;
+
+	a40_bounce = bounce;
+	a40_bounce_pa = bounce_pa;
+	a40_bounce_size = bounce_size;
+	if (SecureDTLookupEntry(NULL, "/a40-mmc", &node) == kSuccess &&
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) == kSuccess && size >= 16) {
+		a40_regs = ml_io_map(reg[0], reg[1]);
+		if (dw_probe() == 0) {
+			a40_blk_kind = 1;
+			return 0;
+		}
+		return EIO;
+	}
+	if (SecureDTLookupEntry(NULL, "/a40-virtio", &node) == kSuccess &&
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) == kSuccess && size >= 16) {
+		if (vio_probe(reg[0], (uint32_t)(reg[1] / 0x200), 0x200) == 0) {
+			a40_blk_kind = 2;
+			return 0;
+		}
+		return EIO;
+	}
+	return ENOENT;
+}
+
+static int
+a40_blk_xfer(uint64_t blk4k, uint32_t count, bool write)
+{
+	if ((uint64_t)count * BLK4K > a40_bounce_size) {
+		return EINVAL;
+	}
+	uint64_t sect = blk4k * SECT_PER_BLK;
+	uint32_t nsect = count * SECT_PER_BLK;
+	int e;
+	if (a40_blk_kind == 1) {
+		/* dw_mmc PIO: at most 128 KiB per command keeps BYTCNT and timeouts sane */
+		for (uint32_t done = 0; done < nsect;) {
+			uint32_t n = MIN(nsect - done, 256u);
+			vm_offset_t save = a40_bounce;
+			a40_bounce += (vm_offset_t)done * SECT;
+			e = dw_xfer(sect + done, n, write);
+			a40_bounce = save;
+			if (e) {
+				a40_mmc_fail(write ? "write" : "read", e);
+				printf("A40 MMC: %s of %u sectors at 0x%llx failed %d (diag %x %x %x %x %x %x %x %x)\n",
+				    write ? "write" : "read", n, sect + done, e,
+				    a40_mmc_diag[0], a40_mmc_diag[1], a40_mmc_diag[2], a40_mmc_diag[3],
+				    a40_mmc_diag[4], a40_mmc_diag[5], a40_mmc_diag[6], a40_mmc_diag[7]);
+				return e;
+			}
+			done += n;
+		}
+		return 0;
+	}
+	if (a40_blk_kind == 2) {
+		return vio_xfer(sect, nsect, write);
+	}
+	return ENXIO;
+}
+
+int
+a40_blk_read(uint64_t blk4k, uint32_t count)
+{
+	return a40_blk_xfer(blk4k, count, false);
+}
+
+int
+a40_blk_write(uint64_t blk4k, uint32_t count)
+{
+	return a40_blk_xfer(blk4k, count, true);
+}
diff --git a/bsd/dev/a40_keys.c b/bsd/dev/a40_keys.c
new file mode 100644
index 0000000..73ba0e4
--- /dev/null
+++ b/bsd/dev/a40_keys.c
@@ -0,0 +1,102 @@
+/*
+ * Galaxy A40 keys: plain GPIOs of the ALIVE pin controller (bank GPA1,
+ * 0x11CB0060: CON +0, DAT +4), active low. S-Boot leaves them configured
+ * as inputs (gpio-keys pin function 0xf = EINT, DAT still reads the level).
+ * Polled every 20 ms from a kernel thread; reported like the SWEET keys:
+ * 0 = power (gpa1-7), 1 = volume up (gpa1-5), 2 = volume down (gpa1-6).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/cpu_number.h>
+#include <mach/mach_time.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+int a40_keys_init(void);
+int a40_platform(void);
+
+static vm_offset_t a40_gpa1;
+static int a40_keys_chan;
+
+static void
+a40_keys_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static const int pin[3] = { 7, 5, 6 };
+	int state[3] = { 0, 0, 0 };
+	for (;;) {
+		uint32_t dat = *(volatile uint32_t *)(a40_gpa1 + 4);
+		for (int k = 0; k < 3; k++) {
+			int down = !(dat & (1u << pin[k]));
+			if (down != state[k]) {
+				state[k] = down;
+				printf("A40 KEYS: key=%d down=%d dat=%#x\n", k, down, dat);
+				sweet_hid_key(k, down);
+			}
+		}
+		assert_wait_timeout((event_t)&a40_keys_chan, THREAD_UNINT, 20, NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+/* Returns 1 when this board has A40 keys (and they were started). */
+/* A40 ADT (phone or QEMU): sweet's Qualcomm drivers must not touch the bus. */
+int
+a40_platform(void)
+{
+	DTEntry node;
+	return SecureDTLookupEntry(NULL, "/a40-mmc", &node) == kSuccess ||
+	       SecureDTLookupEntry(NULL, "/a40-virtio", &node) == kSuccess;
+}
+
+/* A40 diag: A73 cluster clock (CMU_CPUCL0) and measured core frequency. */
+static void
+a40_clock_report(void)
+{
+	vm_offset_t cl0 = ml_io_map(0x10900000, 0x2000);
+	uint32_t pll = *(volatile uint32_t *)(cl0 + 0x140);
+	uint32_t mux = *(volatile uint32_t *)(cl0 + 0x1000);
+	uint32_t div = *(volatile uint32_t *)(cl0 + 0x1810);
+	uint32_t m = (pll >> 16) & 0x3ff, pdiv = (pll >> 8) & 0x3f, sdiv = pll & 7;
+	uint64_t pll_mhz = pdiv ? 26ULL * m / ((uint64_t)pdiv << sdiv) : 0;
+	/* cycle counter over ~50 ms of the 26 MHz timebase */
+	__builtin_arm_wsr64("PMCR_EL0", __builtin_arm_rsr64("PMCR_EL0") | 1);
+	__builtin_arm_wsr64("PMCNTENSET_EL0", 1ULL << 31);
+	__builtin_arm_isb(0xf);
+	uint64_t c0 = __builtin_arm_rsr64("PMCCNTR_EL0"), t0 = mach_absolute_time();
+	while (mach_absolute_time() - t0 < 26000 * 50) {
+	}
+	uint64_t c1 = __builtin_arm_rsr64("PMCCNTR_EL0"), t1 = mach_absolute_time();
+	uint64_t mhz = (c1 - c0) * 26 / (t1 - t0);
+	printf("A40 CLOCK: cpu %d PLL_CPUCL0 %#x (%llu MHz) mux %#x div %#x, measured %llu MHz\n",
+	    cpu_number(), pll, pll_mhz, mux, div, mhz);
+}
+
+int
+a40_keys_init(void)
+{
+	DTEntry node;
+	uint64_t const *reg;
+	unsigned int size;
+	thread_t th;
+
+	if (SecureDTLookupEntry(NULL, "/a40-mmc", &node) == kSuccess) {
+		a40_clock_report();
+	}
+	if (SecureDTLookupEntry(NULL, "/a40-keys", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
+		return a40_platform();  /* A40 without keys (QEMU): never probe sweet's SPMI */
+	}
+	a40_gpa1 = ml_io_map(reg[0] & ~0xfffULL, 0x1000) + (reg[0] & 0xfff);
+	printf("A40 KEYS: gpa1 con %#x dat %#x\n", *(volatile uint32_t *)a40_gpa1,
+	    *(volatile uint32_t *)(a40_gpa1 + 4));
+	if (kernel_thread_start(a40_keys_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+	return 1;
+}
diff --git a/bsd/dev/a40_touch.c b/bsd/dev/a40_touch.c
new file mode 100644
index 0000000..c640939
--- /dev/null
+++ b/bsd/dev/a40_touch.c
@@ -0,0 +1,275 @@
+/*
+ * Galaxy A40 touchscreen: Zinitix ZT7548 at 0x20 on i2c_4 (Samsung
+ * s3c2440-style I2C controller at 0x13870000, pins gpp4-0/1 function 2),
+ * powered by tsp_avdd (gpg2-1, active high), attention line gpa0-0 (low =
+ * data ready). Everything polled from a kernel thread; protocol from
+ * Samsung's zinitix_zt75xx_ts.c (TOUCH_POINT_MODE 0, 5 fingers).
+ * Reported through sweet_hid_touch(finger, down, x, y) in panel pixels.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+int a40_touch_init(void);
+
+#define TOP_PINCTRL     0x139B0000UL
+#define GPP4            0x0A0
+#define GPG2            0x160
+#define ALIVE_GPA0      0x11CB0040UL
+#define I2C4            0x13870000UL
+#define ZT_ADDR         0x20
+
+#define IICCON          0x00
+#define IICSTAT         0x04
+#define IICDS           0x0C
+#define IICLC           0x10
+#define CON_ACK         (1u << 7)
+#define CON_CLK512      (1u << 6)
+#define CON_IRQEN       (1u << 5)
+#define CON_PEND        (1u << 4)
+
+static vm_offset_t top, gpa0, i2c;
+static int a40_touch_chan;
+uint32_t a40_touch_diag[4];
+
+static inline uint32_t rd(vm_offset_t b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static inline void wr(vm_offset_t b, uint32_t o, uint32_t v) { *(volatile uint32_t *)(b + o) = v; }
+
+static void
+sleep_ms(uint32_t ms)
+{
+	assert_wait_timeout((event_t)&a40_touch_chan, THREAD_UNINT, ms, NSEC_PER_MSEC);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+i2c_wait_pend(void)
+{
+	for (int i = 0; i < 20000; i++) {       /* ~ 20 ms */
+		if (rd(i2c, IICCON) & CON_PEND) {
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+static void
+i2c_resume(uint32_t ack)
+{
+	uint32_t c = rd(i2c, IICCON) & ~(CON_PEND | CON_ACK);
+	wr(i2c, IICCON, c | (ack ? CON_ACK : 0));
+}
+
+static void
+i2c_stop(uint32_t mode)
+{
+	wr(i2c, IICSTAT, mode);                 /* BUSY=0: STOP */
+	i2c_resume(1);
+	for (int i = 0; i < 2000 && (rd(i2c, IICSTAT) & (1u << 5)); i++) {
+		delay(1);
+	}
+}
+
+/* write len bytes (first two = register, little endian) */
+static int
+i2c_write(const uint8_t *b, int len)
+{
+	wr(i2c, IICSTAT, 0xD0);                 /* master Tx, output enable */
+	wr(i2c, IICDS, ZT_ADDR << 1);
+	wr(i2c, IICSTAT, 0xF0);                 /* START */
+	if (i2c_wait_pend() || (rd(i2c, IICSTAT) & 1)) {
+		a40_touch_diag[0] = rd(i2c, IICSTAT) | 0x100;
+		i2c_stop(0xD0);
+		return -1;
+	}
+	for (int i = 0; i < len; i++) {
+		wr(i2c, IICDS, b[i]);
+		i2c_resume(1);
+		if (i2c_wait_pend() || (rd(i2c, IICSTAT) & 1)) {
+			a40_touch_diag[1] = rd(i2c, IICSTAT) | (i << 16);
+			i2c_stop(0xD0);
+			return -1;
+		}
+	}
+	i2c_stop(0xD0);
+	return 0;
+}
+
+static int
+i2c_read(uint8_t *b, int len)
+{
+	wr(i2c, IICSTAT, 0x90);                 /* master Rx */
+	wr(i2c, IICDS, (ZT_ADDR << 1) | 1);
+	wr(i2c, IICSTAT, 0xB0);                 /* START */
+	if (i2c_wait_pend() || (rd(i2c, IICSTAT) & 1)) {
+		a40_touch_diag[2] = rd(i2c, IICSTAT) | 0x100;
+		i2c_stop(0x90);
+		return -1;
+	}
+	for (int i = 0; i < len; i++) {
+		i2c_resume(i < len - 1);        /* NACK the last byte */
+		if (i2c_wait_pend()) {
+			i2c_stop(0x90);
+			return -1;
+		}
+		b[i] = (uint8_t)rd(i2c, IICDS);
+	}
+	i2c_stop(0x90);
+	return 0;
+}
+
+static int
+zt_cmd(uint16_t reg)
+{
+	uint8_t b[2] = { (uint8_t)reg, (uint8_t)(reg >> 8) };
+	return i2c_write(b, 2);
+}
+
+static int
+zt_wr(uint16_t reg, uint16_t v)
+{
+	uint8_t b[4] = { (uint8_t)reg, (uint8_t)(reg >> 8), (uint8_t)v, (uint8_t)(v >> 8) };
+	return i2c_write(b, 4);
+}
+
+static int
+zt_rd(uint16_t reg, uint8_t *out, int len)
+{
+	if (zt_cmd(reg)) {
+		return -1;
+	}
+	delay(50);
+	return i2c_read(out, len);
+}
+
+static bool
+zt_power_on(void)
+{
+	uint16_t chip = 0;
+	for (int retry = 0; retry < 4; retry++) {
+		if (zt_wr(0xc000, 1) == 0) {                    /* vendor command enable */
+			delay(10);
+			zt_rd(0xcc00, (uint8_t *)&chip, 2);
+			delay(10);
+			if (zt_cmd(0xc004) == 0 &&              /* INT clear */
+			    zt_wr(0xc002, 1) == 0) {            /* NVM init */
+				delay(2000);
+				if (zt_wr(0xc001, 1) == 0) {    /* program start */
+					sleep_ms(150);
+					printf("A40 TOUCH: chip code %#x\n", chip);
+					return true;
+				}
+			}
+		}
+		sleep_ms(50);
+	}
+	return false;
+}
+
+static bool
+zt_init(void)
+{
+	uint8_t nodes[4] = { 0 };
+	zt_rd(0x0060, nodes, 4);                        /* TOTAL_NUMBER_OF_X/Y, informative */
+	if (zt_cmd(0x0000) ||                           /* SWRESET */
+	    zt_wr(0x0010, 0) ||                         /* TOUCH_MODE = point mode */
+	    zt_wr(0x0023, 0)) {                         /* COVER_CONTROL = open (best effort) */
+		return false;
+	}
+	for (int i = 0; i < 10; i++) {
+		zt_cmd(0x0003);                         /* clear INT, discard garbage */
+		delay(10);
+	}
+	printf("A40 TOUCH: ready, %u x %u nodes\n", nodes[0] | nodes[1] << 8, nodes[2] | nodes[3] << 8);
+	return true;
+}
+
+static void
+a40_touch_thread(__unused void *arg, __unused wait_result_t wr_)
+{
+	uint8_t down[5] = { 0 };
+	uint16_t lx[5] = { 0 }, ly[5] = { 0 };
+
+	/* I2C4 clock: CMU_PERI gate (manual, on) + Q-channel clock request (cmucal-sfr.c 7885) */
+	vm_offset_t cmu = ml_io_map(0x10010000, 0x4000);
+	uint32_t g0 = rd(cmu, 0x2048), q0 = rd(cmu, 0x3028);
+	wr(cmu, 0x2048, (g0 & ~(1u << 28)) | (1u << 20) | (1u << 21));
+	wr(cmu, 0x3028, q0 | (1u << 1));
+	printf("A40 TOUCH: i2c4 gate %#x -> %#x, qch %#x -> %#x\n", g0, rd(cmu, 0x2048), q0, rd(cmu, 0x3028));
+	/* tsp_avdd on (gpg2-1 output high), I2C pins (gpp4-0/1 function 2) */
+	uint32_t con = rd(top, GPG2);
+	wr(top, GPG2, (con & ~(0xfu << 4)) | (1u << 4));
+	wr(top, GPG2 + 4, rd(top, GPG2 + 4) | (1u << 1));
+	con = rd(top, GPP4);
+	wr(top, GPP4, (con & ~0xffu) | 0x22);
+	/* I2C: PCLK/512, prescaler 15 (slow but safe), ACK. IRQEN must be set or the
+	 * pending flag (IICCON[4]) does not work (Samsung UM); the GIC line stays off. */
+	wr(i2c, IICCON, CON_ACK | CON_CLK512 | CON_IRQEN | 0xf);
+	wr(i2c, IICLC, 0x4);                            /* filter on, SDA delay 0 */
+	sleep_ms(100);
+	printf("A40 TOUCH: after setup gpg2 %#x/%#x gpp4 %#x i2c con %#x stat %#x\n",
+	    rd(top, GPG2), rd(top, GPG2 + 4), rd(top, GPP4), rd(i2c, IICCON), rd(i2c, IICSTAT));
+	if (!zt_power_on() || !zt_init()) {
+		printf("A40 TOUCH: controller not responding (diag %#x %#x %#x), touch disabled\n",
+		    a40_touch_diag[0], a40_touch_diag[1], a40_touch_diag[2]);
+		return;
+	}
+	for (;;) {
+		if (rd(gpa0, 4) & 1) {                  /* attention high: nothing new */
+			sleep_ms(8);
+			continue;
+		}
+		uint8_t p[4 + 5 * 6];
+		if (zt_rd(0x0080, p, sizeof(p)) == 0) {
+			uint16_t status = p[0] | p[1] << 8;
+			if (status != 0xffff && !(status & (1u << 13))) {
+				for (int f = 0; f < 5; f++) {
+					const uint8_t *c = p + 4 + 6 * f;
+					uint16_t x = c[0] | c[1] << 8, y = c[2] | c[3] << 8;
+					uint8_t sub = c[5];
+					int now = (sub & 1) && !(sub & (1u << 3));
+					if (now && (!down[f] || x != lx[f] || y != ly[f])) {
+						down[f] = 1;
+						lx[f] = x;
+						ly[f] = y;
+						sweet_hid_touch(f, 1, x, y);
+					} else if (!now && down[f]) {
+						down[f] = 0;
+						sweet_hid_touch(f, 0, lx[f], ly[f]);
+					}
+				}
+			}
+		}
+		zt_cmd(0x0003);                         /* clear INT */
+		sleep_ms(4);
+	}
+}
+
+int
+a40_touch_init(void)
+{
+	DTEntry node;
+	thread_t th;
+
+	if (SecureDTLookupEntry(NULL, "/a40-touch", &node) != kSuccess) {
+		extern int a40_platform(void);
+		return a40_platform();
+	}
+	top = ml_io_map(TOP_PINCTRL, 0x1000);
+	gpa0 = ml_io_map(ALIVE_GPA0 & ~0xfffUL, 0x1000) + (ALIVE_GPA0 & 0xfff);
+	i2c = ml_io_map(I2C4, 0x1000);
+	printf("A40 TOUCH: gpg2 con %#x dat %#x gpp4 con %#x i2c con %#x stat %#x\n",
+	    rd(top, GPG2), rd(top, GPG2 + 4), rd(top, GPP4), rd(i2c, IICCON), rd(i2c, IICSTAT));
+	if (kernel_thread_start(a40_touch_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+	return 1;
+}
