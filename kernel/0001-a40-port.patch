+/* Returns 1 when sent through the GICv2 distributor; 0: caller uses ICC_SGI1R_EL1. */
+int
+pe_gic_send_sgi_v2(unsigned int logical_cpu, unsigned int sgi)
+{
+	if (!sweet_gic_v2) {
+		return 0;
+	}
+	uint32_t mask = logical_cpu < MAX_CPUS ? gicv2_cpu_mask[logical_cpu] : 0;
+	if (!mask) {
+		panic("A40 GIC: no GICv2 CPU interface mask for cpu %u", logical_cpu);
+	}
+	__builtin_arm_dsb(DSB_ISHST);
+	gicd_write32(GICD_SGIR_V2, (mask << 16) | (sgi & 0xF));
+	return 1;
